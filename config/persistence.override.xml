<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!--
      Override de la unidad de persistencia usada por Laboratorio1.jar
      para que NO quede hardcodeada a un host/usuario, y use el DataSource JNDI
      provisto por Tomcat (java:comp/env/jdbc/railway).

      Nota: Debe llamarse igual (name="emf") porque el JAR la busca por ese nombre.
    -->
    <persistence-unit name="emf" transaction-type="RESOURCE_LOCAL">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>

        <!-- Entidades provistas por Laboratorio1.jar -->
        <class>logica.Actividad</class>
        <class>logica.Usuario</class>
        <class>logica.Proveedor</class>
        <class>logica.Turista</class>
        <class>logica.Salida</class>
        <class>logica.Inscripcion</class>

        <properties>
            <!-- Usar el DataSource JNDI del contenedor -->
            <property name="jakarta.persistence.nonJtaDataSource" value="java:comp/env/jdbc/railway"/>
            <property name="eclipselink.jdbc.datasource" value="java:comp/env/jdbc/railway"/>

            <!-- DDL controlado por EclipseLink (se puede ajustar desde el DS o por variable de entorno del contenedor) -->
            <property name="eclipselink.ddl-generation" value="none"/>
            <property name="eclipselink.ddl-generation.output-mode" value="database"/>
            <property name="eclipselink.target-database" value="MySQL"/>
            <property name="eclipselink.logging.level" value="INFO"/>
        </properties>
    </persistence-unit>
</persistence>
