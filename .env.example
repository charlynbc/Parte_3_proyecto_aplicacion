## Archivo de ejemplo `.env` para ejecución local
## COPIA ESTE ARCHIVO A `.env` Y COMPLETA LOS VALORES REALES (por ejemplo, los provistos por Railway)
# Ejemplo usando URL directa de JDBC (Railway suele dar una URL completa)
# DB_URL debe ser una URL JDBC válida, p.ej. jdbc:mysql://host:3306/dbname?params
DB_URL="jdbc:mysql://<HOST>:<PORT>/<DATABASE>?serverTimezone=UTC&useSSL=false"
DB_USER="<DB_USER>"
DB_PASSWORD="<DB_PASSWORD>"

# Opcional: activar DDL solamente para crear el esquema inicialmente.
# Valores permitidos (según EclipseLink): none | create-tables | drop-and-create-tables | create-or-extend-tables
# Dejar en 'none' en producción/entornos compartidos para evitar ALTER repetidos.
DB_DDL=none

# Config de logging/pool opcional
DB_LOG_LEVEL=INFO
DB_MAX_POOL=20
DB_LOGIN_TIMEOUT=30

# Preferencia de fuente de configuración: jndi | env | auto
# - jndi: intenta usar el DataSource Tomcat (jdbc/railway) primero (recomendado)
# - env: usa DB_URL/DB_USER/DB_PASSWORD
# - auto: JNDI si existe, de lo contrario ENV
DB_PREFER_SOURCE=jndi

# Si prefieres usar las variables que Railway exporta (RAILWAY_*), JpaUtil
# ya intenta varios fallbacks. No es necesario rellenar todas.