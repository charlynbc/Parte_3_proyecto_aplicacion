# --- Configuración DB para la aplicación Java (Railway MySQL) ---
# Para forzar uso de JNDI (jdbc/railway) descomenta y deja DB_URL vacío
DB_URL=
# DB_USER y DB_PASSWORD no se usan si se emplea JNDI
DB_USER=
DB_PASSWORD=
DB_DDL=none

# --- Configuración original de la app Node (si aplica) ---
MONGODB_URI=mongodb://localhost:27017/nueva_base_datos
DB_NAME=nueva_base_datos

# Application Configuration
PORT=3000
NODE_ENV=development

# Security
JWT_SECRET=tu_jwt_secret_aqui
SESSION_SECRET=tu_session_secret_aqui
