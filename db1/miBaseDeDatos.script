CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE MEMORY TABLE PUBLIC.USUARIO(CEDULAIDENTIDAD VARCHAR(255) NOT NULL PRIMARY KEY,TIPO_USUARIO VARCHAR(31),APELLIDO VARCHAR(255),NOMBRE VARCHAR(255),NACIONALIDAD VARCHAR(255),DESCRIPCION VARCHAR(255))
CREATE MEMORY TABLE PUBLIC.ACTIVIDAD(NOMBRE VARCHAR(255) NOT NULL PRIMARY KEY,COSTO INTEGER,FECHAHASTA TIMESTAMP,PROVE VARCHAR(255))
CREATE MEMORY TABLE PUBLIC.SALIDA(NOMBRE VARCHAR(255) NOT NULL PRIMARY KEY,FECHA TIMESTAMP,FECHAALTA TIMESTAMP,HORA INTEGER,LUGAR VARCHAR(255),TURISTAMAX INTEGER)
CREATE MEMORY TABLE PUBLIC.INSCRIPCION(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,CANTIDADTURISTAS INTEGER,COSTO INTEGER,FECHAINSCRIPCION DATE,TURISTA_NICK VARCHAR(255),CONSTRAINT FK_INSCRIPCION_TURISTA_NICK FOREIGN KEY(TURISTA_NICK) REFERENCES PUBLIC.USUARIO(CEDULAIDENTIDAD))
ALTER TABLE PUBLIC.INSCRIPCION ALTER COLUMN ID RESTART WITH 1
CREATE MEMORY TABLE PUBLIC.ACTIVIDAD_SALIDA(ACTIVIDAD_NOMBRE VARCHAR(255) NOT NULL,SALIDAS_NOMBRE VARCHAR(255) NOT NULL,PRIMARY KEY(ACTIVIDAD_NOMBRE,SALIDAS_NOMBRE),CONSTRAINT FK_ACTIVIDAD_SALIDA_SALIDAS_NOMBRE FOREIGN KEY(SALIDAS_NOMBRE) REFERENCES PUBLIC.SALIDA(NOMBRE),CONSTRAINT FK_ACTIVIDAD_SALIDA_ACTIVIDAD_NOMBRE FOREIGN KEY(ACTIVIDAD_NOMBRE) REFERENCES PUBLIC.ACTIVIDAD(NOMBRE))
CREATE MEMORY TABLE PUBLIC.SALIDA_INSCRIPCION(SALIDA_NOMBRE VARCHAR(255) NOT NULL,INSCRIPCIONES_ID BIGINT NOT NULL,PRIMARY KEY(SALIDA_NOMBRE,INSCRIPCIONES_ID),CONSTRAINT FK_SALIDA_INSCRIPCION_SALIDA_NOMBRE FOREIGN KEY(SALIDA_NOMBRE) REFERENCES PUBLIC.SALIDA(NOMBRE),CONSTRAINT FK_SALIDA_INSCRIPCION_INSCRIPCIONES_ID FOREIGN KEY(INSCRIPCIONES_ID) REFERENCES PUBLIC.INSCRIPCION(ID))
